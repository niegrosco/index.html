<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Life in France">
<meta name="theme-color" content="#1f3a68">
<title>Life in France</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--blue:#1f3a68;--soft:#e9eef7;--bg:#f7f8fb;--text:#172033;--muted:#5d6678;--line:#dde2ec;--warn:#fff1e6;--warnText:#8a3b00}
body{margin:0;background:var(--bg);color:var(--text);font:17px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,sans-serif;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
main{max-width:640px;margin:auto;padding:14px}
h1{color:var(--blue);font-size:28px;line-height:1.2;margin:8px 0}
h2{font-size:18px;margin:20px 0 8px;color:var(--blue)}
p{margin:6px 0}
.muted{color:var(--muted);font-size:14px}
.langs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
button{font:inherit;border:0;cursor:pointer}
.langs button{padding:9px 2px;border-radius:10px;background:var(--soft);color:var(--blue);font-weight:600;font-size:14px}
.langs button.on{background:var(--blue);color:#fff}
.card{display:block;width:100%;text-align:start;background:#fff;color:var(--text);border:1px solid var(--line);border-radius:14px;padding:14px;margin-top:10px}
.card strong{display:block;font-size:18px}
.urgent{background:var(--warn);border-color:#f2c9a8}
.back{background:none;color:var(--blue);font-weight:600;padding:8px 0}
ul{padding-inline-start:20px;margin:6px 0}li{margin:6px 0}
.step{display:flex;gap:10px;width:100%;text-align:start;align-items:flex-start;background:#fff;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:8px}
.step.on{background:var(--soft)}
.box{flex:none;width:26px;height:26px;border:2px solid var(--blue);border-radius:7px;display:grid;place-items:center;color:#fff}
.on .box{background:var(--blue)}
.warn{background:var(--warn);color:var(--warnText);border-radius:12px;padding:10px 14px}
a{color:var(--blue);overflow-wrap:anywhere}
.notice{border-top:1px solid var(--line);margin-top:22px;padding-top:12px}
</style>
</head>
