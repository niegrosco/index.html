let store={lang:'',done:{}};
try{store=Object.assign(store,JSON.parse(localStorage.getItem('lif.v1'))||{});}catch(e){}
function save(){try{localStorage.setItem('lif.v1',JSON.stringify(store));}catch(e){}}
function pickLang(){
  if(LANGS.some(l=>l[0]===store.lang))return store.lang;
  const b=(navigator.language||'en').slice(0,2);
  return LANGS.some(l=>l[0]===b)?b:'en';
}
let lang=pickLang(), view='home';
function dateText(){const[y,m,d]=CHECKED.split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString(lang,{day:'numeric',month:'long',year:'numeric'});}
function isStale(){const[y,m,d]=CHECKED.split('-').map(Number);return (Date.now()-new Date(y,m-1,d))/864e5>STALE_DAYS;}
function list(a){return '<ul>'+a.map(x=>'<li>'+x+'</li>').join('')+'</ul>';}
function langBar(){return '<div class="langs">'+LANGS.map(l=>`<button class="${l[0]===lang?'on':''}" data-lang="${l[0]}">${l[1]}</button>`).join('')+'</div>';}
function footer(){const u=UI[lang];return `<div class="notice muted"><p>${u.checked} ${dateText()}</p>${isStale()?`<p class="warn">${u.stale}</p>`:''}<p>${u.notice}</p></div>`;}
function home(){
  const u=UI[lang];
  return langBar()+`<h1>${u.app}</h1><p class="muted">${u.tag}</p>
  <button class="card urgent" data-go="help"><strong>🆘 ${u.urgent}</strong><span class="muted">${u.urgentSub}</span></button>`+
  GUIDES.map(g=>{const t=g.t[lang];return `<button class="card" data-go="${g.id}"><strong>${g.icon} ${t.title}</strong><span class="muted">${t.sum}</span></button>`;}).join('')+footer();
}
function guide(g){
  const u=UI[lang],t=g.t[lang],done=store.done[g.id]||[];
  return langBar()+`<button class="back" data-go="home">${u.back}</button><h1>${g.icon} ${t.title}</h1><p>${t.sum}</p>
  ${isStale()?`<p class="warn">${u.stale}</p>`:''}
  <h2>${u.who}</h2>${list(t.who)}<h2>${u.steps}</h2>`+
  t.steps.map((s,i)=>`<button class="step ${done.includes(i)?'on':''}" data-step="${i}" data-guide="${g.id}"><span class="box">${done.includes(i)?'✓':''}</span><span>${s}</span></button>`).join('')+
  `<h2>${u.watch}</h2><div class="warn">${list(t.warn)}</div><h2>${u.src}</h2><ul>`+
  g.src.map(s=>`<li><a href="${s[1]}" target="_blank" rel="noopener noreferrer" dir="ltr">${s[0]}</a></li>`).join('')+'</ul>'+footer();
}
function help(){
  const u=UI[lang];
  return langBar()+`<button class="back" data-go="home">${u.back}</button><h1>🆘 ${u.urgent}</h1><p class="warn"><a href="tel:112">${u.helpIntro}</a></p>`+
  HELP.map(h=>`<a class="card" style="text-decoration:none" ${h.tel?`href="tel:${h.tel}"`:`href="${h.url}" target="_blank" rel="noopener noreferrer"`}><strong>${h.t[lang][0]}</strong><span class="muted">${h.t[lang][1]}</span></a>`).join('')+footer();
}
function render(){
  const root=document.documentElement;
  root.lang=lang;root.dir=lang==='ar'?'rtl':'ltr';
  document.title=UI[lang].app;
  const g=GUIDES.find(x=>x.id===view);
  document.getElementById('app').innerHTML=view==='help'?help():g?guide(g):home();
}
document.addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  if(b.dataset.lang){lang=b.dataset.lang;store.lang=lang;save();render();return;}
  if(b.dataset.go){view=b.dataset.go;render();scrollTo(0,0);return;}
  if(b.dataset.step!==undefined){
    const id=b.dataset.guide,i=Number(b.dataset.step),d=store.done[id]||[];
    store.done[id]=d.includes(i)?d.filter(x=>x!==i):[...d,i];
    const y=scrollY;save();render();scrollTo(0,y);
  }
});
render();
</script>
</body>
</html>
